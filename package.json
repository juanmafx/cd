{
  "name": "cd",
  "version": "2.0.1",
  "description": "Minimal hardened Express service that replies to any GET path with the server time the request was handled.",
  "type": "module",
  "main": "src/main.js",
  "exports": "./src/app.js",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/main.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\"",
    "test:report": "node scripts/write-test-report.js",
    "audit:prod": "npm audit --omit=dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanmafx/cd.git"
  },
  "author": "Juan Manuel Ramallo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/juanmafx/cd/issues"
  },
  "homepage": "https://github.com/juanmafx/cd#readme",
  "dependencies": {
    "express": "5.3.0"
  }
}
